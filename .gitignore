# Build outputs
/dist
/node_modules
/src-tauri/target
/src-tauri/gen
/src-tauri/Cargo.lock
src-tauri/binaries/*.exe
src-tauri/binaries/*.dll

# Tauri updater signing key. The .pub file IS committed (so the
# app can verify signed updates) but the private .key must NEVER
# be committed — losing it means no future updates can be signed.
src-tauri/.tauri-updater.key

# Build outputs for the auxiliary tauri-signer crate (a local
# replacement for the broken tauri-cli signer — see
# src-tauri/crates/tauri-signer/). The target/ subdir is local
# build output and shouldn't go in git.
src-tauri/crates/tauri-signer/target/
src-tauri/crates/tauri-signer/Cargo.lock

# Runtime cache (wry / webview2 data, written to cwd in dev mode)
src-tauri/cache.db
src-tauri/cache.db-shm
src-tauri/cache.db-wal
src-tauri/EBWebView/

# OS junk
.DS_Store
Thumbs.db

# Editor
.vscode
.idea
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Local config
.env.local
.env.*.local
src-tauri/.env
