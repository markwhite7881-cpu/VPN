# Build outputs
/dist
/node_modules
/src-tauri/target
/src-tauri/Cargo.lock

# Tauri generated mobile/desktop projects: gen/ is mostly build junk,
# BUT gen/android contains our hand-written Kotlin VPN layer, manifest
# and gradle customizations — those MUST be tracked (Tauri docs also
# recommend committing the generated Android project once customized).
# So instead of ignoring all of gen/, ignore only derived artifacts:
/src-tauri/gen/schemas
/src-tauri/gen/android/.gradle
/src-tauri/gen/android/.idea
/src-tauri/gen/android/.cxx
/src-tauri/gen/android/build
/src-tauri/gen/android/local.properties
/src-tauri/gen/android/**/build
/src-tauri/gen/android/**/*.iml
# libbox.aar is a 28MB prebuilt binary — CI rebuilds it from the
# Leadaxe/sing-box-lx fork (see .github/workflows/release-android.yml),
# so the AAR itself is not committed.
/src-tauri/gen/android/app/libs/*.aar
# Never commit Android signing material.
/src-tauri/gen/android/key.properties
/src-tauri/gen/android/**/*.keystore
/src-tauri/gen/android/**/*.jks

# Windows sing-box sidecar (and its runtime DLLs). macOS / Linux
# sidecars (no extension / .app bundles / AppImage) are NOT ignored
# — they're committed so end-users don't need to install sing-box
# themselves. Same for icon.icns (macOS bundle icon).
src-tauri/binaries/*.exe
src-tauri/binaries/*.dll

# Tauri updater signing key. The .pub file IS committed (so
# clients can verify our signatures); the secret key is NEVER
# committed.
src-tauri/.tauri-updater.key

# Local env / secrets
.env

# Tauri / Cargo build cache artifacts
Cargo.lock.bak
**/*.rs.bk

# Tauri / Vite dev output
**/node_modules

# OS / editor scratch
.DS_Store
Thumbs.db

# mavis / agent throwaway files. `.tmp*/` covers .tmp-gh, .tmp.TRASH,
# .tmp-rebuild, etc.; `*.TRASH` covers per-extension backups; the
# rest are specific file names we've seen pollute the working tree.
.tmp*/
*.TRASH
*portable.exe
*portable.exe.sig
TAG_MESSAGE.txt
.wsl/
dist-release/

# Local Android build scratch: NDK zip (~750MB), gomobile output AAR,
# extracted jars, logs. CI rebuilds all of this from scratch.
/.android-build/

# A file literally named "NUL" — Windows reserved-name artifact from a
# mis-redirected shell command; must never be committed (git on
# Windows can't even check it out cleanly).
NUL

# Generated latest.json (Tauri updater manifest) lives next to the
# project root on a release engineer machine. NEVER committed; we
# always upload it as a Release asset instead so the running app
# can fetch the same canonical URL across all installs.
/latest.json
